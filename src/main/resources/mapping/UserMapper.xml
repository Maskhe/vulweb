<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper
namespace="cn.bestsec.vulweb.mapper.UserMapper">
    <select id="queryUserByName" resultType="cn.bestsec.vulweb.entity.User">
        select * from user where name=#{name}
    </select>
    <select id="queryUserByNameVul" resultType="cn.bestsec.vulweb.entity.User">
        select * from user where name='${name}'
    </select>
</mapper>